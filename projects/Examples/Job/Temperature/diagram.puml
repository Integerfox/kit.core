@startuml classDiagram_examplesjobtemperature
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide members
left to right direction

' ============================================================================
' example.cpp - leftmost element
' ============================================================================


' ============================================================================
' Application Classes  (middle column)
' ============================================================================

package "Examples::Job::Temperature" {
    class Temperature
    class "example.cpp" as exampleApp <<application>>
}

package "mp" {
    object "tempSensor1 : Mp::Float" as mpTempSensor1
    object "tempSensor2 : Mp::Float" as mpTempSensor2
    object "g_modelDatabase : ModelDatabase" as mpDB
}

' ============================================================================
' Kit Classes  (right column, stacked vertically)
' ============================================================================

package "Kit::Job" {
    class JobBase
    class Manager
    class "TShell::Cmd" as JobShellCmd
}

package "Kit::EventQueue" {
    class "Server" as EqServer
}

package "Kit::Itc" {
    class OpenCloseSync
}

package "Kit::System" {
    class Semaphore
    class Thread
    class Shutdown
    class Timer
}

package "Kit::Dm" {
    class "Mp::Float" as MpFloat
    class "TShell::Write" as DmWrite
    class "TShell::Read" as DmRead
}

package "Kit::Container" {
    class "OrderedList<IJob>" as JobList
}

package "Kit::TShell" {
    class Processor
    class StdioThread
    class NoSecurity
    class "Command::Bye" as Bye
    class "Command::Help" as Help
    class "Command::Echo" as Echo
    class "Command::Trace" as Trace
    class "Command::Wait" as Wait
}

' ============================================================================
' Layout hints
' ============================================================================

' Pin exampleApp to the left of the Application classes
exampleApp  -[hidden]right- Temperature

' Stack Application classes above mp (vertically)
Temperature -[hidden]down- mpTempSensor1

' Stack Kit packages vertically (right column)
JobBase       -[hidden]down- EqServer
EqServer      -[hidden]down- OpenCloseSync
OpenCloseSync -[hidden]down- Semaphore
Semaphore     -[hidden]down- MpFloat
MpFloat       -[hidden]down- JobList
JobList       -[hidden]down- Processor
Processor     -[hidden]down- StdioThread

' ============================================================================
' Inheritance
' ============================================================================

Temperature --|>  JobBase
Temperature --|>  Timer
Manager     --|>  OpenCloseSync

' ============================================================================
' Composition / Aggregation
' ============================================================================

Temperature   o--  MpFloat  : m_mpTemperature
Manager       o--  JobList  : m_jobs
Processor     o--  CommandList : m_commands
StdioThread   o--  Processor : m_shell
mpTempSensor1 -->  mpDB     : registered in
mpTempSensor2 -->  mpDB     : registered in

' ============================================================================
' example.cpp usage relationships
' ============================================================================

exampleApp ..> EqServer       : jobEventQueue_
exampleApp ..> Semaphore      : waitForShutdown_
exampleApp ..> Thread         : t1
exampleApp ..> Manager        : jobManager_
exampleApp ..> Temperature    : temperature_ / temperature2_
exampleApp ..> JobList        : jobList_
exampleApp ..> Shutdown       : success() / failure()
exampleApp ..> CommandList   : g_commandList
exampleApp ..> Processor     : tshell_
exampleApp ..> StdioThread   : stdioThread_
exampleApp ..> NoSecurity    : securityPolicy_
exampleApp ..> Bye           : byeCmd_
exampleApp ..> Help          : helpCmd_
exampleApp ..> Echo          : echoCmd_
exampleApp ..> Trace         : traceCmd_
exampleApp ..> Wait          : waitCmd_
exampleApp ..> DmWrite       : dmWriteCmd_
exampleApp ..> DmRead        : dmReadCmd
exampleApp ..> JobShellCmd   : jobCmd_

@enduml

